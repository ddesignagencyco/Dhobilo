{
  "name": "dhoblio",
  "private": true,
  "version": "0.1.0",
  "description": "Dhoblio: laundry and dry-cleaning aggregator platform",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api:dev": "npm run start:dev -w @dhoblio/api",
    "api:build": "npm run build -w @dhoblio/api",
    "api:test": "npm run test -w @dhoblio/api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
