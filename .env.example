NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# Comma-separated browser origins allowed by CORS (defaults to APP_URL)
CORS_ORIGINS=http://localhost:3000
# Reverse-proxy hops to trust for the client IP (rate limits). 0 = none; use 1 behind a single load balancer.
TRUST_PROXY=0

# Host-side URLs (running the API with `npm run api:dev`). docker-compose overrides these for containers.
DATABASE_URL=postgresql://dhoblio:dhoblio@localhost:5432/dhoblio?schema=public
REDIS_URL=redis://localhost:6379

# Generate secrets: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Dev/staging only. The app refuses to boot with OTP_BYPASS=true in production.
OTP_BYPASS=true
OTP_TTL_SECONDS=300

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENC_KEY_ID=k1
ENC_KEY_BASE64=
HMAC_KEY_BASE64=
# Key rotation: set a new ENC_KEY_ID + ENC_KEY_BASE64 and list the retired key(s) here as "id=base64,id2=base64"
# so existing CNIC ciphertext stays readable (it is re-encrypted with the new key when an admin views it).
ENC_PREVIOUS_KEYS=

# If this Cloudinary account is shared with another app: use a Dhoblio-only upload preset (signed, jpg/png/webp)
# and ideally a separate API key. Dhoblio only ever touches the dhoblio/<env>/ folder.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
# Top-level folder for everything Dhoblio uploads. Pick one no other app uses (the files end up in
# <root>/<env>/vendors/<user>/docs/...). Deliberately not called CLOUDINARY_FOLDER so it can't be mixed up.
CLOUDINARY_FOLDER_ROOT=dhoblio

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Dhoblio <no-reply@dhoblio.pk>"
# prod: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 (Google App Password)

SMS_PROVIDER=mock
SMS_API_KEY=
WHATSAPP_PROVIDER=mock
WHATSAPP_TOKEN=

# mock = log only; fcm = real push through Firebase (then the three FCM_* values below are required)
PUSH_PROVIDER=mock
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Delivery and dispatch
RIDER_FEE_PICKUP_PKR=80
RIDER_FEE_DROP_PKR=120
DISPATCH_LEAD_MIN=60
DISPATCH_OFFER_TIMEOUT_SEC=90
DISPATCH_MAX_ATTEMPTS=8
DISPATCH_RETRY_SEC=30
RIDER_HEARTBEAT_TTL_SEC=120
RIDER_MAX_ACTIVE_JOBS=3
RIDER_TRACKING_ENABLED=true
DELIVERY_OTP_TTL_HOURS=24
DELIVERY_OTP_MAX_ATTEMPTS=5
OPS_ALERT_EMAIL=
COURIER_MOCK_WEBHOOK_SECRET=

# Payments
# true = every online method (card, JazzCash, Easypaisa, Raast) uses a built-in fake gateway. Development and tests only.
PAYMENT_MOCK_GATEWAY=true
PAYMENT_MOCK_SECRET=dev-only-mock-gateway-secret
PAYMENT_TIMEOUT_MIN=15
PAYMENT_RECONCILE_AFTER_MIN=10
PAYOUT_MIN_PKR=500
# JazzCash (leave all three empty to keep it off)
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_BASE_URL=https://sandbox.jazzcash.com.pk

GOOGLE_MAPS_API_KEY=

BULL_BOARD_ENABLED=false
LOG_LEVEL=info
